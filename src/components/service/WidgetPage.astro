---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route, type Locale } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { helpers } from '../../lib/helpers';
import { EMBED } from '../../lib/embed';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang); const T = H.T;
const e = EMBED[lang];
const code = `<iframe src="${SITE_URL}/embed/${e.slug}/" title="${e.title}" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const title = T('Strompreis-Rechner je Viertelstunde auf Ihrer Seite einbinden', 'Embed the quarter-hourly power price calculator on your site', 'De stroomprijs per kwartier op je eigen site insluiten');
const description = T(
  'Binden Sie den Endpreis je Viertelstunde für heute und morgen kostenlos als iframe ein: Börsenpreis mit Steuern, Kurve, günstigste Stunde, ohne Anmeldung und ohne Cookie.',
  'Embed the all-in price per quarter hour for today and tomorrow free of charge as an iframe: exchange price with taxes, curve, cheapest hour, no sign-up, no cookie.',
  'Sluit de eindprijs per kwartier voor vandaag en morgen gratis in als iframe: beursprijs met belastingen, grafiek, goedkoopste uur, zonder registratie en zonder cookie.');
const crumb = T('Rechner einbinden', 'Embed the calculator', 'Rekenhulp insluiten');
---
<PageLayout title={title} description={description} lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: T('Startseite', 'Home', 'Home'), path: route('home', lang) }, { name: crumb, path: route('widget', lang) }])]} breadcrumbs={[{ label: crumb }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{crumb}</h1>
    <p class="mt-3 text-lg text-navy-700">{T('Ein Code zum Kopieren, kostenlos. Energiegenossenschaften, Solarvereine, Mieterbeiräte und Lokalredaktionen zeigen damit den Strompreis des Tages auf ihrer eigenen Seite.', 'One code to copy, free of charge. Energy cooperatives, solar groups, tenant boards and local newsrooms use it to show the day’s power price on their own pages.', 'Eén code om te kopiëren, gratis. Energiecoöperaties, buurtinitiatieven en lokale redacties tonen er de stroomprijs van de dag mee op hun eigen site.')}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>{T('Bedingungen: die Nennung „Bundesnetzagentur | SMARD.de“ und der Link unter dem Rechner bleiben sichtbar, der Inhalt wird nicht verändert, Bereitstellung ohne Gewähr. Neue Preise erscheinen bei Ihnen, sobald wir sie geladen haben.', 'Terms: the “Bundesnetzagentur | SMARD.de” credit and the link under the calculator stay visible, the content is not altered, no warranty. New prices appear on your page as soon as we have loaded them.', 'Voorwaarden: de vermelding „Bundesnetzagentur | SMARD.de” en de link onder de rekenhulp blijven zichtbaar, de inhoud wordt niet gewijzigd, zonder garantie. Nieuwe prijzen verschijnen bij jou zodra wij ze geladen hebben.')}</p>
    <p>{T('Andere Sprachen:', 'Other languages:', 'Andere talen:')} {Object.values(EMBED).filter((x) => x.slug !== e.slug).map((x, i) => <>{i > 0 && ' · '}<code>{`${SITE_URL}/embed/${x.slug}/`}</code></>)}</p>
    <p>{T('Was Ihre Besucher eingeben, bleibt in ihrem Browser, und der eingebettete Rahmen setzt kein Cookie. Fragen über die', 'Whatever your visitors type stays in their browser, and the embedded frame sets no cookie. Questions via the', 'Wat uw bezoekers invullen blijft in hun browser en het ingesloten kader plaatst geen cookie. Vragen via de')} <a href={route('contact', lang)}>{T('Kontaktseite', 'contact page', 'contactpagina')}</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${e.slug}/`} title={e.title} width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
