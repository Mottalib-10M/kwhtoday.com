---
/** Einbettbare Seite (iframe) : Rechner der ganzen Fahrt, ohne Navigation. noindex, außerhalb der Sitemap. */
import '../styles/global.css';
import ToolFor from './ToolFor.astro';
import Attribution from './Attribution.astro';
import { ZONES } from '../lib/engine/tarif';
import { SITE_URL, LANG_TAGS, SITE_NAMES } from '../data/site-config';
import { route, type Locale } from '../i18n/routes';
import { EMBED } from '../lib/embed';
interface Props { lang: Locale }
const { lang } = Astro.props;
const home = `${SITE_URL}${route('home', lang)}`;
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{EMBED[lang].title} – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <ToolFor tool="preis" zonen={lang === 'nl' ? ['NL', 'BE', 'DE-LU', 'AT', 'PL'] : [...ZONES]} lang={lang} id="embed" methodHref={`${SITE_URL}${route('method', lang)}`} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={home} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a></p>
    <Attribution lang={lang} class="mt-1 text-center" />
  </body>
</html>
